---
import Layout from '../layouts/Layout.astro';
---
<Layout title="I Beat Economics">

<style is:global>
/* ── Today heading (admin trigger) ───────────────────── */
#today-trigger {
  cursor: pointer;
  user-select: none;
  display: inline-block;
  margin-bottom: 1rem;
}
#today-trigger:hover { color: var(--accent); }

/* ── Today card ───────────────────────────────────────── */
.econ-today-loading {
  color: var(--text-muted);
  font-style: italic;
  font-size: 0.9rem;
  margin-bottom: 1rem;
}
.econ-today-card {
  background: #fff;
  border-left: 4px solid var(--accent);
  border-radius: 0 6px 6px 0;
  padding: 1.25rem 1.5rem;
  box-shadow: 0 1px 4px rgba(20,92,52,0.07);
  margin-bottom: 0.4rem;
}
.econ-today-card p  { margin: 0 0 0.55em; }
.econ-today-card p:last-child { margin-bottom: 0; }
.econ-today-card ul,
.econ-today-card ol { padding-left: 1.4em; margin: 0.2em 0 0.55em; }
.econ-today-card li { margin-bottom: 0.15em; }
.econ-today-card a  { color: var(--accent); }
.econ-today-card strong { font-weight: 700; }

.econ-today-ts {
  font-size: 0.74rem;
  color: var(--text-muted);
  font-style: italic;
  margin-bottom: 1.5rem;
}
.econ-today-empty {
  color: var(--text-muted);
  font-style: italic;
  font-size: 0.95rem;
  margin-bottom: 1.5rem;
}

/* ── Archive ──────────────────────────────────────────── */
.econ-arch-wrap { margin-top: 0.5rem; }
.econ-arch-hdr {
  display: flex;
  align-items: center;
  gap: 1rem;
  border-bottom: 1px solid #c8e6d4;
  padding-bottom: 0.35rem;
  margin-bottom: 0.65rem;
}
.econ-arch-lbl {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--text-muted);
}
.econ-show-all {
  margin-left: auto;
  font-size: 0.78rem;
  color: var(--accent);
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  text-decoration: underline;
}
.econ-show-all:hover { opacity: 0.7; }

.econ-arch-item {
  border: 1px solid #dff0e7;
  border-radius: 5px;
  margin-bottom: 5px;
  background: #fff;
  overflow: hidden;
}
.econ-arch-row {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  padding: 0.5rem 0.9rem;
}
.econ-arch-date {
  font-size: 0.74rem;
  color: var(--text-muted);
  white-space: nowrap;
  flex-shrink: 0;
}
.econ-arch-peek {
  font-size: 0.85rem;
  color: #555;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
  font-style: italic;
}
.econ-arch-content {
  padding: 0.55rem 0.9rem 0.65rem;
  border-top: 1px solid #f0faf4;
  font-size: 0.88rem;
  line-height: 1.65;
}
.econ-arch-content p  { margin: 0 0 0.45em; }
.econ-arch-content p:last-child { margin-bottom: 0; }
.econ-arch-content ul,
.econ-arch-content ol { padding-left: 1.3em; margin: 0.15em 0 0.45em; }
.econ-arch-content a  { color: var(--accent); }
.econ-arch-more {
  display: block;
  font-size: 0.74rem;
  color: var(--accent);
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.2rem 0.9rem 0.55rem;
  text-decoration: underline;
}
.econ-arch-more:hover { opacity: 0.7; }
.econ-arch-edit-btn {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 0.72rem;
  color: var(--accent);
  background: none;
  border: 1px solid var(--accent);
  border-radius: 3px;
  cursor: pointer;
  padding: 1px 7px;
  opacity: 0.7;
}
.econ-arch-edit-btn:hover { opacity: 1; background: #f0faf4; }

/* ── Admin modals ─────────────────────────────────────── */
.econ-adm-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  align-items: center;
  justify-content: center;
}
.econ-adm-overlay.visible { display: flex; }
.econ-adm-win {
  background: #fff;
  border-radius: 8px;
  border: 2px solid var(--accent);
  width: 340px;
  max-width: 95vw;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
}
.econ-adm-win.wide { width: 520px; }
.econ-adm-titlebar {
  background: var(--accent);
  color: #fff;
  padding: 0.7rem 1rem;
  font-weight: 700;
  font-size: 0.9rem;
  border-radius: 6px 6px 0 0;
}
.econ-adm-body { padding: 1rem 1rem 0.25rem; }
.econ-adm-label {
  display: block;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--accent);
  margin-bottom: 0.4rem;
}
.econ-adm-input {
  width: 100%;
  box-sizing: border-box;
  border: 2px solid var(--accent);
  border-radius: 4px;
  padding: 0.45rem 0.75rem;
  font-size: 1.2rem;
  letter-spacing: 0.25em;
  background: #f0faf4;
  outline: none;
}
.econ-adm-error {
  color: #c00;
  font-size: 0.78rem;
  margin-top: 0.4rem;
}
.econ-adm-toolbar {
  display: flex;
  gap: 4px;
  margin-bottom: 5px;
  flex-wrap: wrap;
}
.econ-adm-tool {
  padding: 3px 10px;
  font-size: 0.78rem;
  font-weight: 700;
  border: 1.5px solid var(--accent);
  background: #f0faf4;
  color: var(--accent);
  cursor: pointer;
  border-radius: 3px;
  line-height: 1.4;
}
.econ-adm-tool:hover { background: var(--accent); color: #fff; }
.econ-date-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 5px;
}
.econ-date-input {
  border: 1.5px solid var(--accent);
  border-radius: 3px;
  padding: 2px 6px;
  font-size: 0.82rem;
  background: #f0faf4;
  color: var(--text);
  outline: none;
}
.econ-adm-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 2px solid var(--accent);
  border-radius: 4px;
  padding: 0.55rem 0.75rem;
  font-size: 0.9rem;
  font-family: inherit;
  background: #f0faf4;
  min-height: 220px;
  resize: vertical;
  outline: none;
}
.econ-adm-preview-label {
  display: block;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #888;
  margin: 0.6rem 0 0.3rem;
}
.econ-adm-preview {
  border: 1px solid #ddd;
  background: #fff;
  padding: 0.55rem 0.75rem;
  min-height: 36px;
  font-size: 0.88rem;
  line-height: 1.6;
  max-height: 160px;
  overflow-y: auto;
  border-radius: 4px;
}
.econ-adm-preview p { margin: 0 0 0.4em; }
.econ-adm-footer {
  padding: 0.75rem 1rem 1rem;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
}
.econ-adm-btn {
  padding: 0.38rem 1rem;
  font-size: 0.82rem;
  font-weight: 700;
  border: 2px solid;
  border-radius: 4px;
  cursor: pointer;
}
.econ-btn-save   { background: var(--accent); color: #fff; border-color: #0e4226; }
.econ-btn-save:hover   { background: #0e4226; }
.econ-btn-new    { background: #2563eb; color: #fff; border-color: #1d4ed8; }
.econ-btn-new:hover    { background: #1d4ed8; }
.econ-btn-clear  { background: #dc2626; color: #fff; border-color: #b91c1c; }
.econ-btn-clear:hover  { background: #b91c1c; }
.econ-btn-cancel { background: #6b7280; color: #fff; border-color: #4b5563; margin-left: auto; }
.econ-btn-cancel:hover { background: #4b5563; }
.econ-choice-note {
  font-size: 0.875rem;
  color: #555;
  margin-bottom: 0.75rem;
  line-height: 1.5;
}
.econ-choice-btns { display: flex; gap: 8px; }
.econ-choice-btns .econ-adm-btn { flex: 1; text-align: center; }
</style>

<div style="padding: 2rem 0 0.25rem;">
  <h1 id="today-trigger">Today</h1>
  <p id="today-loading" class="econ-today-loading">Loading&hellip;</p>
  <div id="today-card" class="econ-today-card" style="display:none;">
    <div id="today-body"></div>
  </div>
  <div id="today-ts" class="econ-today-ts" style="display:none;"></div>
  <p id="today-empty" class="econ-today-empty" style="display:none;">
    It&rsquo;s been a while! Have an explore through the menu above, or go to the <a href="#archive-section">archive of Today messages</a>.
  </p>
</div>

<div id="archive-section" class="econ-arch-wrap" style="display:none;">
  <div class="econ-arch-hdr">
    <span class="econ-arch-lbl">Previous</span>
    <button id="show-all-btn" class="econ-show-all">Show all</button>
  </div>
  <div id="archive-list"></div>
</div>

<!-- Passcode modal -->
<div class="econ-adm-overlay" id="adm-pass-modal">
  <div class="econ-adm-win">
    <div class="econ-adm-titlebar">Teacher access</div>
    <div class="econ-adm-body">
      <label class="econ-adm-label" for="adm-pass-input">Passcode</label>
      <input class="econ-adm-input" id="adm-pass-input" type="password" maxlength="10" autocomplete="off" placeholder="&bull;&bull;&bull;&bull;">
      <div class="econ-adm-error" id="adm-pass-error" style="display:none;">Incorrect passcode.</div>
    </div>
    <div class="econ-adm-footer">
      <button class="econ-adm-btn econ-btn-save" id="adm-pass-btn">Unlock</button>
      <button class="econ-adm-btn econ-btn-cancel" id="adm-pass-cancel">Cancel</button>
    </div>
  </div>
</div>

<!-- Choice modal -->
<div class="econ-adm-overlay" id="adm-choice-modal">
  <div class="econ-adm-win">
    <div class="econ-adm-titlebar">Today&rsquo;s post</div>
    <div class="econ-adm-body">
      <p class="econ-choice-note">Edit the current post, or archive it and write a new one.</p>
      <div class="econ-choice-btns">
        <button class="econ-adm-btn econ-btn-save" id="adm-choice-edit">Edit current</button>
        <button class="econ-adm-btn econ-btn-new"  id="adm-choice-new">Post new</button>
      </div>
    </div>
    <div class="econ-adm-footer">
      <button class="econ-adm-btn econ-btn-cancel" id="adm-choice-archive">Edit an old post&hellip;</button>
      <button class="econ-adm-btn econ-btn-cancel" id="adm-choice-cancel">Cancel</button>
    </div>
  </div>
</div>

<!-- Edit modal -->
<div class="econ-adm-overlay" id="adm-edit-modal">
  <div class="econ-adm-win wide">
    <div class="econ-adm-titlebar" id="adm-edit-title">Today&rsquo;s post</div>
    <div class="econ-adm-body">
      <label class="econ-adm-label" for="adm-edit-textarea">Write what students should see. Supports markdown.</label>
      <div class="econ-adm-toolbar">
        <button class="econ-adm-tool" id="tool-bold"><b>B</b></button>
        <button class="econ-adm-tool" id="tool-italic"><i>I</i></button>
        <button class="econ-adm-tool" id="tool-link">Link</button>
        <button class="econ-adm-tool" id="tool-bullet">&bull; List</button>
      </div>
      <div class="econ-date-row">
        <input type="date" id="tool-date-input" class="econ-date-input">
        <button class="econ-adm-tool" id="tool-date-insert">Insert date</button>
      </div>
      <textarea class="econ-adm-textarea" id="adm-edit-textarea"
        placeholder="e.g. Today we&#39;re on **3.2 AD/AS** — open the [notes](/ibecon/unit3/3-2/) and work through the AD section.&#10;&#10;- Do Now: three questions on the board&#10;- Activity: Changes in AD worksheet"></textarea>
      <span class="econ-adm-preview-label">Preview</span>
      <div class="econ-adm-preview" id="adm-preview"></div>
    </div>
    <div class="econ-adm-footer">
      <button class="econ-adm-btn econ-btn-save"  id="adm-save-btn">Save</button>
      <button class="econ-adm-btn econ-btn-clear" id="adm-clear-btn">Clear board</button>
      <button class="econ-adm-btn econ-btn-cancel" id="adm-edit-cancel">Cancel</button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script type="module" is:inline>
import { initializeApp }                                 from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js';
import { getDatabase, ref, set, push, remove, onValue } from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js';

const app = initializeApp({
  apiKey:            'AIzaSyBGdNJgl1PG0IueYQk_jjn4cOg-sMFbHe0',
  authDomain:        'dowserboard.firebaseapp.com',
  projectId:         'dowserboard',
  databaseURL:       'https://dowserboard-default-rtdb.firebaseio.com',
  storageBucket:     'dowserboard.firebasestorage.app',
  messagingSenderId: '1032600748722',
  appId:             '1:1032600748722:web:1584c7508fbbca617cbfab',
}, 'ibecon-today');

const db       = getDatabase(app);
const TODAY    = ref(db, 'ibecon/today');
const ARCHIVE  = ref(db, 'ibecon/archive');
const TWO_WEEKS = 14 * 24 * 60 * 60 * 1000;
const PASSCODE  = '0987';

let currentText      = '';
let currentTs        = 0;
let isNewPost        = false;
let adminUnlocked    = false;
let editingArchKey   = null;
let editingArchTs    = 0;

/* ── helpers ─────────────────────────────────── */
function peekText(text) {
  const first = text.split('\n').find(l => l.trim()) || '';
  return first.replace(/[#*_[\]()]/g, '').trim().slice(0, 110);
}

function truncateMd(text, nLines) {
  const lines = text.split('\n').filter(l => l.trim());
  return lines.slice(0, nLines).join('\n\n');
}

/* ── Today listener ──────────────────────────── */
onValue(TODAY, snap => {
  document.getElementById('today-loading').style.display = 'none';
  const data  = snap.val();
  const stale = !data?.text?.trim() || (Date.now() - (data.ts || 0) > TWO_WEEKS);

  if (stale) {
    document.getElementById('today-card').style.display  = 'none';
    document.getElementById('today-ts').style.display    = 'none';
    document.getElementById('today-empty').style.display = 'block';
    currentText = '';
    currentTs   = 0;
  } else {
    currentText = data.text;
    currentTs   = data.ts;
    document.getElementById('today-body').innerHTML = marked.parse(data.text);
    const d = new Date(data.ts);
    const tsEl = document.getElementById('today-ts');
    tsEl.textContent =
      'Posted ' + d.toLocaleDateString() + ' at ' +
      d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    tsEl.style.display = 'block';
    document.getElementById('today-card').style.display  = 'block';
    document.getElementById('today-empty').style.display = 'none';
  }
});

/* ── Archive listener ────────────────────────── */
onValue(ARCHIVE, snap => {
  const data  = snap.val();
  const items = data
    ? Object.entries(data).map(([k, v]) => ({ ...v, _key: k })).sort((a, b) => b.ts - a.ts)
    : [];
  const section = document.getElementById('archive-section');
  const list    = document.getElementById('archive-list');
  if (!items.length) { section.style.display = 'none'; return; }
  section.style.display = 'block';
  list.innerHTML = '';
  items.forEach((item, i) => {
    list.appendChild(makeArchItem(item, i < 3 ? 'brief' : 'minimal'));
  });
});

function makeArchItem(item, tier) {
  const d = new Date(item.ts);
  const dateStr =
    d.toLocaleDateString(undefined, { weekday:'short', day:'numeric', month:'short' }) +
    ' · ' + d.toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' });

  const el = document.createElement('div');
  el.className = 'econ-arch-item';
  el.dataset.fullText = item.text;
  el.dataset.archKey  = item._key;

  // always-visible row: date (+ peek for minimal only) + admin edit btn
  const row = document.createElement('div');
  row.className = 'econ-arch-row';
  row.innerHTML = '<span class="econ-arch-date">' + dateStr + '</span>' +
    (tier === 'minimal'
      ? '<span class="econ-arch-peek">' + peekText(item.text) + '</span>'
      : '');

  const editBtn = document.createElement('button');
  editBtn.className = 'econ-arch-edit-btn';
  editBtn.textContent = 'Edit';
  editBtn.style.display = adminUnlocked ? 'inline' : 'none';
  editBtn.addEventListener('click', e => {
    e.stopPropagation();
    openArchiveEdit(item._key, item.text, item.ts);
  });
  row.appendChild(editBtn);
  el.appendChild(row);

  const more = document.createElement('button');
  more.className = 'econ-arch-more';
  more.textContent = 'More…';

  if (tier === 'brief') {
    const content = document.createElement('div');
    content.className = 'econ-arch-content';
    content.innerHTML = marked.parse(truncateMd(item.text, 3));
    el.appendChild(content);
    el.appendChild(more);
    more.addEventListener('click', () => {
      content.innerHTML = marked.parse(item.text);
      more.style.display = 'none';
      el.dataset.expanded = '1';
    });
  } else {
    el.appendChild(more);
    more.addEventListener('click', () => {
      const content = document.createElement('div');
      content.className = 'econ-arch-content';
      content.innerHTML = marked.parse(item.text);
      el.insertBefore(content, more);
      more.style.display = 'none';
      el.dataset.expanded = '1';
    });
  }

  return el;
}

function openArchiveEdit(key, text, ts) {
  editingArchKey = key;
  editingArchTs  = ts;
  isNewPost      = false;
  const ta = document.getElementById('adm-edit-textarea');
  ta.value = text;
  document.getElementById('adm-edit-title').textContent = 'Edit archived post';
  document.getElementById('adm-clear-btn').textContent  = 'Delete post';
  // set date picker to the archive entry's original date
  const d = new Date(ts);
  document.getElementById('tool-date-input').value =
    d.getFullYear() + '-' +
    String(d.getMonth() + 1).padStart(2, '0') + '-' +
    String(d.getDate()).padStart(2, '0');
  updatePreview();
  document.getElementById('adm-edit-modal').classList.add('visible');
  setTimeout(() => ta.focus(), 50);
}

/* ── Show all ────────────────────────────────── */
document.getElementById('show-all-btn').addEventListener('click', () => {
  document.querySelectorAll('.econ-arch-item').forEach(item => {
    if (item.dataset.expanded === '1') return;
    const more    = item.querySelector('.econ-arch-more');
    const content = item.querySelector('.econ-arch-content');
    const full    = marked.parse(item.dataset.fullText);
    if (content) {
      content.innerHTML = full;
    } else {
      const c = document.createElement('div');
      c.className = 'econ-arch-content';
      c.innerHTML = full;
      item.insertBefore(c, more);
    }
    if (more) more.style.display = 'none';
    item.dataset.expanded = '1';
  });
});

/* ── Admin trigger ───────────────────────────── */
document.getElementById('today-trigger').addEventListener('click', () => {
  document.getElementById('adm-pass-input').value = '';
  document.getElementById('adm-pass-error').style.display = 'none';
  document.getElementById('adm-pass-modal').classList.add('visible');
  setTimeout(() => document.getElementById('adm-pass-input').focus(), 50);
});

function tryPasscode() {
  if (document.getElementById('adm-pass-input').value === PASSCODE) {
    document.getElementById('adm-pass-modal').classList.remove('visible');
    adminUnlocked = true;
    document.querySelectorAll('.econ-arch-edit-btn').forEach(b => b.style.display = 'inline');
    if (currentText.trim()) {
      document.getElementById('adm-choice-modal').classList.add('visible');
    } else {
      openEdit(false);
    }
  } else {
    document.getElementById('adm-pass-error').style.display = 'block';
    document.getElementById('adm-pass-input').value = '';
    document.getElementById('adm-pass-input').focus();
  }
}
document.getElementById('adm-pass-btn').addEventListener('click', tryPasscode);
document.getElementById('adm-pass-input').addEventListener('keydown', e => {
  if (e.key === 'Enter') tryPasscode();
});
document.getElementById('adm-pass-cancel').addEventListener('click', () => {
  document.getElementById('adm-pass-modal').classList.remove('visible');
});

/* ── Choice modal ────────────────────────────── */
document.getElementById('adm-choice-edit').addEventListener('click', () => {
  document.getElementById('adm-choice-modal').classList.remove('visible');
  openEdit(false);
});
document.getElementById('adm-choice-new').addEventListener('click', () => {
  document.getElementById('adm-choice-modal').classList.remove('visible');
  openEdit(true);
});
document.getElementById('adm-choice-archive').addEventListener('click', () => {
  document.getElementById('adm-choice-modal').classList.remove('visible');
  document.getElementById('archive-section').scrollIntoView({ behavior: 'smooth' });
});
document.getElementById('adm-choice-cancel').addEventListener('click', () => {
  document.getElementById('adm-choice-modal').classList.remove('visible');
});

function todayDateValue() {
  const d = new Date();
  return d.getFullYear() + '-' +
    String(d.getMonth() + 1).padStart(2, '0') + '-' +
    String(d.getDate()).padStart(2, '0');
}

function openEdit(isNew) {
  isNewPost      = isNew;
  editingArchKey = null;
  const ta  = document.getElementById('adm-edit-textarea');
  ta.value  = isNew ? '' : currentText;
  document.getElementById('adm-edit-title').textContent =
    isNew ? 'New post' : 'Edit current post';
  document.getElementById('adm-clear-btn').textContent = 'Clear board';
  document.getElementById('tool-date-input').value = todayDateValue();
  updatePreview();
  document.getElementById('adm-edit-modal').classList.add('visible');
  setTimeout(() => ta.focus(), 50);
}

/* ── Toolbar ─────────────────────────────────── */
function wrap(before, after) {
  const ta  = document.getElementById('adm-edit-textarea');
  const s   = ta.selectionStart, e = ta.selectionEnd;
  const sel = ta.value.slice(s, e) || 'text';
  ta.value  = ta.value.slice(0, s) + before + sel + after + ta.value.slice(e);
  ta.focus();
  ta.setSelectionRange(s + before.length, s + before.length + sel.length);
  updatePreview();
}
document.getElementById('tool-bold').addEventListener('click',   () => wrap('**', '**'));
document.getElementById('tool-italic').addEventListener('click', () => wrap('*', '*'));
document.getElementById('tool-bullet').addEventListener('click', () => {
  const ta = document.getElementById('adm-edit-textarea');
  const s  = ta.selectionStart;
  const ls = ta.value.lastIndexOf('\n', s - 1) + 1;
  ta.value = ta.value.slice(0, ls) + '- ' + ta.value.slice(ls);
  ta.focus(); updatePreview();
});
document.getElementById('tool-link').addEventListener('click', () => {
  const url = prompt('URL (include https://):', 'https://');
  if (!url) return;
  const ta  = document.getElementById('adm-edit-textarea');
  const s   = ta.selectionStart, e = ta.selectionEnd;
  const lbl = ta.value.slice(s, e) || 'link text';
  ta.value  = ta.value.slice(0, s) + '[' + lbl + '](' + url + ')' + ta.value.slice(e);
  ta.focus(); updatePreview();
});
document.getElementById('tool-date-insert').addEventListener('click', () => {
  const val = document.getElementById('tool-date-input').value;
  if (!val) return;
  // parse as local date to avoid timezone shift
  const [y, m, dd] = val.split('-').map(Number);
  const d = new Date(y, m - 1, dd);
  const month   = d.toLocaleDateString('en', { month: 'long' });
  const day     = d.getDate();
  const weekday = d.toLocaleDateString('en', { weekday: 'long' });
  const line    = '**' + month + ' ' + day + ', ' + weekday + '**\n\n';
  const ta      = document.getElementById('adm-edit-textarea');
  const s       = ta.selectionStart;
  ta.value      = ta.value.slice(0, s) + line + ta.value.slice(s);
  ta.focus();
  ta.setSelectionRange(s + line.length, s + line.length);
  updatePreview();
});
function updatePreview() {
  const text = document.getElementById('adm-edit-textarea').value;
  document.getElementById('adm-preview').innerHTML = text ? marked.parse(text) : '';
}
document.getElementById('adm-edit-textarea').addEventListener('input', updatePreview);

/* ── Save / Clear / Cancel ───────────────────── */
document.getElementById('adm-save-btn').addEventListener('click', async () => {
  const text = document.getElementById('adm-edit-textarea').value.trim();
  if (!text) return;
  if (editingArchKey) {
    await set(ref(db, 'ibecon/archive/' + editingArchKey), { text, ts: editingArchTs });
  } else {
    if (isNewPost && currentText.trim()) {
      await push(ARCHIVE, { text: currentText, ts: currentTs });
    }
    await set(TODAY, { text, ts: Date.now() });
  }
  document.getElementById('adm-edit-modal').classList.remove('visible');
});
document.getElementById('adm-clear-btn').addEventListener('click', async () => {
  if (editingArchKey) {
    if (!confirm('Delete this archived post? This cannot be undone.')) return;
    await remove(ref(db, 'ibecon/archive/' + editingArchKey));
  } else {
    if (!confirm('Clear the board? Students will see "nothing posted today".')) return;
    await remove(TODAY);
  }
  document.getElementById('adm-edit-modal').classList.remove('visible');
});
document.getElementById('adm-edit-cancel').addEventListener('click', () => {
  document.getElementById('adm-edit-modal').classList.remove('visible');
});
</script>

</Layout>
