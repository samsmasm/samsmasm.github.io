{
  // unisam-tracker: serves Sam's private project list to unisam.nz/tracker/.
  // The page is a static shell on GitHub Pages; only the API goes to the Worker.
  "name": "unisam-tracker",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  "routes": [
    { "pattern": "unisam.nz/tracker/api/*", "zone_name": "unisam.nz" },
    { "pattern": "www.unisam.nz/tracker/api/*", "zone_name": "unisam.nz" }
  ],

  // One key, "projects": the parsed list uploaded by tracker/publish.py.
  "kv_namespaces": [
    { "binding": "TRACKER_KV", "id": "2d1aa07811684070a8728f5877b57468" }
  ],

  "vars": {
    "FIREBASE_PROJECT": "coldwar-d8109",
    "ALLOWED_EMAIL": "samgetsstuffdone@gmail.com"
  },

  "observability": { "enabled": true }

  // Secrets (set with `wrangler secret put`, never committed):
  //   ADMIN_KEY  - lets publish.py upload the list. Value in ~/.config/unisam-tracker-admin-key.
  //   DEVICE_KEY - optional, for the e-paper board's names-only page. Unset = board page off.
}
