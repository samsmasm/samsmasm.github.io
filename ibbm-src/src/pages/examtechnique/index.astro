---
import Layout from '../../layouts/Layout.astro';

const skills = [
  { slug: 'explain-advantages-disadvantages', title: 'Explain Advantages and Disadvantages', desc: 'The 4-mark "explain one advantage and one disadvantage" question — state it, explain it in the case, then hammer it home.', topics: ['5.4 Location', '1.2 Types of Business Entities'] },
  { slug: '10-mark-decision', title: 'The 10-mark Decision Question', desc: 'Structuring an answer that must reach a justified decision between two named options — Option A / Option B / Compare / Limitations.', topics: ['5.2 Operations Methods'] },
];
---
<Layout title="Exam Technique">
  <div class="breadcrumb">
    <a href="/ibbm/">Home</a>
    <span class="sep">›</span>
    <span>Exam Technique</span>
  </div>

  <div class="topic-hero">
    <span class="topic-number">Exam Technique</span>
    <h1>Exam Technique</h1>
    <p class="subtitle">
      Skills that show up across topics — question types, command terms, and how examiners actually award marks. Each skill is tagged with the topics it applies to.
    </p>
  </div>

  <div class="topic-grid">
    {skills.map(s => (
      <a href={`/ibbm/examtechnique/${s.slug}/`} class="topic-card">
        <div class="card-num">Skill</div>
        <div class="card-title">{s.title}</div>
        <div class="card-desc">{s.desc}</div>
        <div class="card-desc" style="margin-top:0.5rem;"><strong>Applies to:</strong> {s.topics.join(', ')}</div>
      </a>
    ))}
  </div>
</Layout>
