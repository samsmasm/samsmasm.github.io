---
import Layout from '../../layouts/Layout.astro';

const topics = [
  { num: '2.1', title: 'Introduction to Human Resource Management', slug: '2-1', desc: 'What HR does, the factors behind HR planning, and why people resist change.', hl: false },
  { num: '2.2', title: 'Organizational Structure', slug: '2-2', desc: 'Delegation, span of control, hierarchy, centralization, delayering and matrix structures.', hl: false },
  { num: '2.3', title: 'Leadership and Management', slug: '2-3', desc: 'Leaders vs managers, five leadership styles, and scientific vs intuitive thinking (HL).', hl: false },
];
---
<Layout title="IBBM: Unit 2: Human Resource Management">
  <div class="breadcrumb">
    <a href="/ibbm/">Home</a>
    <span class="sep">›</span>
    <span>Unit 2</span>
  </div>

  <div class="topic-hero">
    <span class="topic-number">Unit 2</span>
    <h1>Human Resource Management</h1>
    <p class="subtitle">
      Select a topic to view notes and practice exercises.
      More topics will be added as we cover them.
    </p>
  </div>

  <div class="topic-grid">
    {topics.map(t => (
      <a href={`/ibbm/unit2/${t.slug}/`} class="topic-card">
        <div class="card-num">{t.num}</div>
        <div class="card-title">{t.title}</div>
        <div class="card-desc">{t.desc}</div>
        {t.hl && <span class="card-hl">HL only</span>}
      </a>
    ))}
  </div>
</Layout>
