---
import Layout from '../../layouts/Layout.astro';

const topics = [
  { num: '5.1', title: 'Introduction to Operations Management', slug: '5-1', desc: 'The transformation process, and how operations connects to marketing, HR and finance.', hl: false },
  { num: '5.2', title: 'Operations Methods', slug: '5-2', desc: 'Job, batch, mass/flow and mass customisation — how each works and why a business chooses it.', hl: false },
  { num: '5.3', title: 'Lean Production and Quality Management', slug: '5-3', desc: 'Kaizen, JIT, cradle to cradle, and QC, QA, quality circles, benchmarking, TQM and standards.', hl: true },
  { num: '5.4', title: 'Location', slug: '5-4', desc: 'STEEPLE and location decisions, plus outsourcing, insourcing, offshoring and reshoring.', hl: false },
  { num: '5.6', title: 'Production Planning', slug: '5-6', desc: 'Supply chains, JIT vs JIC, stock control charts, productivity and make or buy.', hl: true },
  { num: '5.8', title: 'Research and Development', slug: '5-8', desc: 'Why R&D matters, types of innovation, and protecting ideas: patents, copyright, trademarks.', hl: true },
];
---
<Layout title="IBBM: Unit 5 — Operations Management">
  <div class="breadcrumb">
    <a href="/ibbm/">Home</a>
    <span class="sep">›</span>
    <span>Unit 5</span>
  </div>

  <div class="topic-hero">
    <span class="topic-number">Unit 5</span>
    <h1>Operations Management</h1>
    <p class="subtitle">
      Select a topic to view notes, worked examples, and practice exercises.
      More topics will be added as we cover them.
    </p>
  </div>

  <div class="topic-grid">
    {topics.map(t => (
      <a href={`/ibbm/unit5/${t.slug}/`} class="topic-card">
        <div class="card-num">{t.num}</div>
        <div class="card-title">{t.title}</div>
        <div class="card-desc">{t.desc}</div>
        {t.hl && <span class="card-hl">HL only</span>}
      </a>
    ))}
  </div>
</Layout>
