---
import Layout from '../../layouts/Layout.astro';

const topics = [
  { num: '5.1', title: 'Introduction to Operations Management', slug: '5-1', desc: 'The transformation process, and how operations connects to marketing, HR and finance.', hl: false },
  { num: '5.2', title: 'Operations Methods', slug: '5-2', desc: 'Job, batch, mass/flow and mass customisation — how each works and why a business chooses it.', hl: false },
];
---
<Layout title="IBBM: Unit 5 — Operations Management">
  <div class="breadcrumb">
    <a href="/ibbm/">Home</a>
    <span class="sep">›</span>
    <span>Unit 5</span>
  </div>

  <div class="topic-hero">
    <span class="topic-number">Unit 5</span>
    <h1>Operations Management</h1>
    <p class="subtitle">
      Select a topic to view notes, worked examples, and practice exercises.
      More topics will be added as we cover them.
    </p>
  </div>

  <div class="topic-grid">
    {topics.map(t => (
      <a href={`/ibbm/unit5/${t.slug}/`} class="topic-card">
        <div class="card-num">{t.num}</div>
        <div class="card-title">{t.title}</div>
        <div class="card-desc">{t.desc}</div>
        {t.hl && <span class="card-hl">HL only</span>}
      </a>
    ))}
  </div>
</Layout>
