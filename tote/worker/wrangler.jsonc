{
  // unisam-tote: stores Tote's notes for unisam.nz/tote/ (and /typeit's "Save to Tote").
  // Notes arrive already encrypted in the browser; this Worker never sees the passphrase or the text.
  "name": "unisam-tote",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  "routes": [
    { "pattern": "unisam.nz/tote/api/*", "zone_name": "unisam.nz" },
    { "pattern": "www.unisam.nz/tote/api/*", "zone_name": "unisam.nz" }
  ],

  // Keys: "meta" (passphrase salt + check value, no expiry) and "n:<id>" (one encrypted note,
  // KV expirationTtl 96h, so KV itself deletes it when it expires).
  "kv_namespaces": [
    { "binding": "TOTE_KV", "id": "1b2addd4b218455ab0b6aa5c1ea4e9c1" }
  ],

  "vars": {
    "FIREBASE_PROJECT": "coldwar-d8109",
    "ALLOWED_EMAIL": "samgetsstuffdone@gmail.com"
  },

  "observability": { "enabled": true }
}
