{
  // unisam-feedback: one feedback / fault-report inbox for every unisam.nz tool.
  // Tools POST to https://unisam.nz/feedback/api/report; Sam reads reports at
  // unisam.nz/feedback/ (static page in this repo, needs the admin key).
  "name": "unisam-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Only the API path goes to the Worker; /feedback/ itself stays on GitHub Pages.
  "routes": [
    { "pattern": "unisam.nz/feedback/api/*", "zone_name": "unisam.nz" },
    { "pattern": "www.unisam.nz/feedback/api/*", "zone_name": "unisam.nz" }
  ],

  // Reports (r:*), their screenshots (img:*) and rate-limit counters (rl:*).
  "kv_namespaces": [
    { "binding": "FEEDBACK_KV", "id": "6d5cb30ddee542f2b72e67c101e4d526" }
  ],

  "observability": { "enabled": true }

  // Secrets (set with `wrangler secret put`, never committed):
  //   ADMIN_KEY - long random string; unlocks the reports page and API.
}
