{
  // Sayso — marking transcription Worker.
  // Single Worker serves the static frontend (./public) AND the API (/api/*).
  "name": "sayso",
  "main": "src/worker.js",
  "compatibility_date": "2025-07-01",

  // Serve at unisam.nz/sayso (the rest of unisam.nz stays on GitHub Pages).
  "routes": [
    { "pattern": "unisam.nz/sayso", "zone_name": "unisam.nz" },
    { "pattern": "unisam.nz/sayso/*", "zone_name": "unisam.nz" }
  ],

  // Static frontend. Non-/api requests that don't match a file fall through to
  // the Worker, which serves index.html (SPA fallback via ASSETS.fetch).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Transcript storage. TTL is set per-record from the retention setting, so
  // old sessions auto-expire. No audio is ever written here — text only.
  "kv_namespaces": [
    { "binding": "SAYSO_KV", "id": "0c6fc7602cff4df28e5bc4f5684a3999" }
  ],

  "observability": { "enabled": true }

  // Secrets (set with `wrangler secret put`, never committed):
  //   OPENAI_API_KEY   - your OpenAI key. Charged per transcription.
  //   SITE_PASSWORD    - the single shared login password.
  //   SESSION_SECRET   - a long random string used to sign session cookies.
}
