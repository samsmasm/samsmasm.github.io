// Checkin - Firestore security rules.
// Paste these into the Firebase console for the coldwar-d8109 project:
// Firestore Database > Rules > Publish.
//
// These rules cover Firestore only. Operation: Shadow Protocol uses that
// project's Realtime Database, which has a separate ruleset and a separate
// Rules tab in the console, and is not touched here.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function classDoc(cid) {
      return get(/databases/$(database)/documents/classes/$(cid)).data;
    }

    function isTeacher(cid) {
      return signedIn() && classDoc(cid).ownerUid == uid();
    }

    function isStudent(cid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/classes/$(cid)/members/$(uid()));
    }

    function inClass(cid) {
      return isTeacher(cid) || isStudent(cid);
    }

    // A real account, as opposed to the throwaway one a person answering a one
    // off test is given. Anything that creates something lasting asks for this,
    // so a passer by cannot fill the database with containers and codes.
    function realAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // A one off test: a container with no roll, answered by people with no
    // account, who are signed in anonymously so a write can still be pinned to
    // somebody. Everything below that opens a door for them checks this first,
    // so none of it can ever apply to a real class.
    function isOneOff(cid) {
      return classDoc(cid).kind == 'oneoff';
    }

    function runIsOpen(cid, sid) {
      return get(/databases/$(database)/documents/classes/$(cid)/sets/$(sid)).data.status == 'open';
    }

    // Someone sitting a one off test right now: signed in somehow, on a one off
    // container, on a run that is open, writing under their own uid.
    function takingRun(cid, sid, studentId) {
      return signedIn() && studentId == uid() && isOneOff(cid) && runIsOpen(cid, sid);
    }

    // Each person's own record, including the cached list of their classes.
    match /users/{userId} {
      allow read, write: if signedIn() && userId == uid();
    }

    // Join codes are looked up one at a time by code, never listed.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if realAccount() && request.resource.data.ownerUid == uid();
      allow update, delete: if realAccount() && resource.data.ownerUid == uid();
    }

    // Run codes for one off tests. Looked up one at a time by the code someone
    // was given, never listed, so a code cannot be guessed at wholesale.
    match /runCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if realAccount() && request.resource.data.ownerUid == uid();
      allow update, delete: if realAccount() && resource.data.ownerUid == uid();
    }

    match /classes/{cid} {
      // A one off container holds a name and an owner and nothing private. It has
      // to be readable by whoever is sitting the test, who is in no class.
      allow get: if inClass(cid) || isOneOff(cid);
      allow list: if false;
      allow create: if realAccount() && request.resource.data.ownerUid == uid();
      allow update, delete: if isTeacher(cid);

      // The roll. A student writes only their own entry, with their real Google
      // address, and only if the teacher has not removed them.
      match /members/{memberId} {
        allow get: if isTeacher(cid) || memberId == uid();
        allow list: if isTeacher(cid);
        allow create: if signedIn()
          && memberId == uid()
          && request.resource.data.role == 'student'
          && request.resource.data.email == request.auth.token.email
          && !exists(/databases/$(database)/documents/classes/$(cid)/blocked/$(uid()));
        allow update: if isTeacher(cid) || memberId == uid();
        allow delete: if isTeacher(cid) || memberId == uid();
      }

      // Removed students. Only the teacher ever reads or writes this.
      match /blocked/{blockedId} {
        allow read, write: if isTeacher(cid);
      }

      match /sets/{sid} {
        // One at a time by id for a one off test: the id comes from the code they
        // were given, so this cannot be used to wander through other runs, and
        // listing stays shut to everyone but the teacher.
        allow get: if inClass(cid) || isOneOff(cid);
        allow list: if inClass(cid);
        allow write: if isTeacher(cid);

        // Names claimed in a room with no accounts. Read one at a time by id, so
        // checking whether a name is taken cannot become a way to pull out the
        // list of who is in the room.
        match /names/{slug} {
          allow get: if isTeacher(cid) || isOneOff(cid);
          allow list: if isTeacher(cid);
          allow create: if isTeacher(cid) || takingRun(cid, sid, request.resource.data.uid);
          allow update: if isTeacher(cid) || (signedIn() && resource.data.uid == uid());
          allow delete: if isTeacher(cid);
        }

        // The answer key. Copied onto the set document by the app only when
        // students are allowed to see it, so until then it is unreadable here.
        match /keys/{keyId} {
          allow read, write: if isTeacher(cid);
        }

        // One document per student per set.
        match /responses/{studentId} {
          allow get: if isTeacher(cid) || studentId == uid();
          allow list: if isTeacher(cid);

          // A student may write only their own answers, only while the set is
          // open, and may never touch the marks.
          allow create: if isTeacher(cid) || (
            (isStudent(cid) || isOneOff(cid))
            && studentId == uid()
            && get(/databases/$(database)/documents/classes/$(cid)/sets/$(sid)).data.status == 'open'
            && !('marks' in request.resource.data)
            && !('score' in request.resource.data)
          );

          allow update: if isTeacher(cid) || (
            (isStudent(cid) || isOneOff(cid))
            && studentId == uid()
            && get(/databases/$(database)/documents/classes/$(cid)/sets/$(sid)).data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['answers', 'name', 'email', 'updatedAt', 'submittedAt'])
          );

          allow delete: if isTeacher(cid);

          // Practice retakes. Private to the student who made them: the teacher
          // is deliberately not given read access, so revising in private cannot
          // become something they are judged on. Writable at any time, including
          // on a closed set, which is the whole point. The rules above still stop
          // a student touching their real attempt once the set is shut.
          match /retakes/{attemptId} {
            allow read, write: if signedIn() && studentId == uid();
          }
        }
      }
    }
  }
}
